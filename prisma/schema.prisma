generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String   @id @db.Uuid
  root      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  snapshots Snapshot[]

  @@map("pie_projects")
}

model Snapshot {
  id        String   @id @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  createdAt DateTime @map("created_at")
  payload   Json
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  evidence  Evidence[]
  nodes     GraphNode[]
  edges     GraphEdge[]
  verificationRuns VerificationRun[]
  functionalRecords FunctionalRecord[]
  httpProbes HttpProbe[]
  planContestations PlanContestation[]

  @@index([projectId, createdAt, id])
  @@map("pie_snapshots")
}

model Evidence {
  id         String   @id @db.Uuid
  snapshotId String   @map("snapshot_id") @db.Uuid
  payload    Json
  snapshot   Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  verificationRun VerificationRun?
  httpProbe HttpProbe?

  @@index([snapshotId])
  @@map("pie_evidence")
}

model FunctionalRecord {
  id String @id @db.Uuid
  snapshotId String @map("snapshot_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  payload Json
  snapshot Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  @@index([snapshotId, createdAt, id], map: "pie_functional_snapshot")
  @@map("pie_functional_records")
}

model HttpProbe {
 id String @id @db.Uuid
 snapshotId String @map("snapshot_id") @db.Uuid
 evidenceId String @unique @map("evidence_id") @db.Uuid
 createdAt DateTime @map("created_at") @db.Timestamptz(3)
 payload Json
 snapshot Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
 evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
 @@index([snapshotId, createdAt, id], map: "pie_http_probe_snapshot")
 @@map("pie_http_probes")
}

model PlanContestation {
 id String @id @db.Uuid
 snapshotId String @map("snapshot_id") @db.Uuid
 planDigest String @map("plan_digest")
 createdAt DateTime @map("created_at") @db.Timestamptz(3)
 payload Json
 snapshot Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
 @@index([snapshotId, planDigest, createdAt, id], map: "pie_plan_contestation_snapshot")
 @@map("pie_plan_contestations")
}

model VerificationRun {
  id String @id @db.Uuid
  snapshotId String @map("snapshot_id") @db.Uuid
  evidenceId String @unique @map("evidence_id") @db.Uuid
  createdAt DateTime @map("created_at")
  payload Json
  snapshot Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@index([snapshotId, createdAt, id])
  @@map("pie_verification_runs")
}

model GraphNode {
  snapshotId String @map("snapshot_id") @db.Uuid
  id         String
  kind       String
  path       String
  payload    Json
  snapshot   Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@id([snapshotId, id])
  @@index([snapshotId, path])
  @@map("pie_graph_nodes")
}

model GraphEdge {
  snapshotId String @map("snapshot_id") @db.Uuid
  id         String
  sourceId   String @map("source_id")
  targetId   String @map("target_id")
  kind       String
  payload    Json
  snapshot   Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@id([snapshotId, id])
  @@index([snapshotId, sourceId])
  @@index([snapshotId, targetId])
  @@map("pie_graph_edges")
}

model Job {
  id             String   @id @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key")
  kind           String
  state          String
  payload        Json
  result         Json?
  errorCode      String?  @map("error_code")
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3) @map("max_attempts")
  timeoutMs      Int      @map("timeout_ms")
  owner          String?
  leaseToken     String?  @map("lease_token") @db.Uuid
  leaseUntil     BigInt?  @map("lease_until")
  createdAt      BigInt   @map("created_at")
  updatedAt      BigInt   @map("updated_at")

  @@index([state, createdAt, id])
  @@map("pie_jobs")
}
